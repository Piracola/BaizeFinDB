TUSHARE_TOKEN=

# Optional Telegram Bot MVP settings. Keep real tokens/secrets out of git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
