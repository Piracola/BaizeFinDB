APP_NAME=BaizeFinDB
APP_ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://baizefindb:baizefindb@localhost:5432/baizefindb
REDIS_URL=redis://localhost:6379/0

# Optional overrides. Leave empty to reuse REDIS_URL.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
RADAR_SCAN_INTERVAL_SECONDS=300
RADAR_CONTINUOUS_P1_TRIGGER_COUNT=3
RADAR_CONTINUITY_WINDOW_MINUTES=30
OPS_DISK_CHECK_PATH=.
OPS_DISK_FREE_PERCENT_ALERT_THRESHOLD=10
OPS_CPU_USAGE_PERCENT_ALERT_THRESHOLD=90
OPS_MEMORY_USED_PERCENT_ALERT_THRESHOLD=90

# Optional Tushare Pro token. Enables manual Tushare fetches.
TUSHARE_TOKEN=
# Optional Celery Beat schedule for Tushare anns_d announcements.
# Default stays off so Tushare quota/permission issues cannot affect the 5-minute radar loop.
TUSHARE_ANNS_D_BEAT_ENABLED=false
TUSHARE_ANNS_D_BEAT_INTERVAL_SECONDS=3600

# Optional Telegram Bot MVP settings. Keep real tokens/secrets out of git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_REQUIRE_BINDING=false
TELEGRAM_PUSH_ENABLED=false

# Optional model provider settings for future LLM-backed analysis.
# Default stays disabled; readiness checks are local/no-call and never print keys.
MODEL_ANALYSIS_ENABLED=false
MODEL_PROVIDER=disabled
MODEL_PRIMARY_MODEL=
MODEL_FALLBACK_MODEL=
MODEL_API_BASE_URL=
MODEL_API_KEY=
OPENAI_API_KEY=
MODEL_AUDIT_STORE_RAW_PROMPT=false
